# Copy to .env (start.sh does this automatically). All values are optional; defaults shown.

# Market data (Binance public endpoints, no API key needed)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
INTERVAL=1m
HISTORY_BARS=500
BINANCE_REST=https://api.binance.com
BINANCE_WS=wss://stream.binance.com:9443

# Paper account
STARTING_CASH=100000
FEE_RATE=0.001
SLIPPAGE_BPS=2

# Default risk limits (fractions; 0 disables SL/TP/trailing/daily limit). Editable live in the dashboard.
MAX_POSITION_PCT=0.20
MAX_OPEN_POSITIONS=3
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
TRAILING_STOP_PCT=0
DAILY_LOSS_LIMIT_PCT=0.05

# Local LLM via Ollama (falls back to rule-based analysis if unavailable)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6-moe-uncensored
OLLAMA_TIMEOUT=90

# SQLite file (default: data/trading.db under the project root)
# DB_PATH=/absolute/path/to/trading.db

# Set to 1 to skip the Binance connection (used by tests / offline work)
# MARKET_DISABLED=1

# Server port used by start.sh
# PORT=8000
